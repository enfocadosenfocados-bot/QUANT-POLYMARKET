# QUANT POLYMARKET - variables de entorno para la campaña demo >15d y el respaldo off-site.
# Copia este archivo a .env (está en .gitignore) y rellena lo que vayas a usar.

# --- Campaña de experimentación ---
CAMPAIGN_NAME=demo-15d
CAMPAIGN_MIN_DAYS=15

# --- Modo Híbrido: órdenes "live" simuladas contra el libro real ---
# Todas las estrategias pasan por el MISMO motor que paper, pero el fill se
# simula recorriendo la profundidad real del libro (VWAP, fills parciales,
# fee taker / rebate maker) en lugar de estimar con un slippage fijo.
HYBRID_ENABLED=1
HYBRID_MIN_FILL_RATIO=0.5
HYBRID_ALLOW_PARTIAL=1
# Guardar también las órdenes RECHAZADAS en el ledger append-only (auditoría
# completa). Por defecto 0: solo se guardan las ejecutadas y los rechazos se
# agregan como contadores (evita millones de líneas en el respaldo).
#HYBRID_ORDERS_LEDGER_ALL=0
#HYBRID_STORAGE_FILE=paper_trades_hybrid.json
#HYBRID_ORDERS_FILE=hybrid_orders.json

# --- Respaldo off-site (lista separada por comas: local,git,s3,http) ---
# Con "local" el track record se queda en ESTA VPS: activa siempre git o s3
# para poder recuperarlo si te retiran el servidor.
# Revisar la copia descargada sin VPS:  python3 ver_track_record.py /ruta/track_record
BACKUP_ENABLED=1
BACKUP_TARGETS=local
BACKUP_INTERVAL_SECONDS=900

# Backend Git (recomendado): crea un repo PRIVADO vacío y pega su URL + un PAT con permiso de escritura.
# NO apuntes a la rama "main" del repo del código: usa un repo dedicado
# o, si reutilizas este repo, BACKUP_GIT_BRANCH=trackrecord.
#BACKUP_GIT_REMOTE=https://github.com/TU_USUARIO/quant-polymarket-trackrecord.git
#BACKUP_GIT_BRANCH=main
#BACKUP_GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Backend S3 / Cloudflare R2 / Backblaze B2 / MinIO (requiere: pip install boto3)
#BACKUP_S3_BUCKET=mi-bucket
#BACKUP_S3_PREFIX=quant-polymarket
#BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#BACKUP_S3_REGION=auto
#BACKUP_S3_ACCESS_KEY=xxxxxxxx
#BACKUP_S3_SECRET_KEY=xxxxxxxx

# Backend HTTP webhook (Google Apps Script / n8n / Make / Supabase)
#BACKUP_HTTP_URL=https://script.google.com/macros/s/XXXX/exec
#BACKUP_HTTP_TOKEN=
